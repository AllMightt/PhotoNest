page {
  min-height: 100%;
  background: #f9f9f9;
  color: #1a1a1a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

view,
image,
text,
input,
textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 44rpx 30rpx calc(156rpx + env(safe-area-inset-bottom));
  background: #f9f9f9;
  box-sizing: border-box;
}

.section {
  margin: 54rpx 0 0;
  padding: 42rpx 0 0;
  background: transparent;
  border-top: 1rpx solid rgba(26, 26, 26, 0.14);
  border-radius: 0;
  box-sizing: border-box;
}

.eyebrow {
  color: #9b7a19;
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 0.22em;
  line-height: 1.4;
  text-transform: uppercase;
}

.title {
  margin-top: 12rpx;
  color: #1a1a1a;
  font-family: "Songti SC", "STSong", "Times New Roman", serif;
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 0;
  line-height: 1.12;
}

.muted {
  color: #5d5f5f;
  font-size: 26rpx;
  line-height: 1.78;
}

.hero-image,
.work-cover,
.package-cover {
  width: 100%;
  display: block;
  background: #e9e7e1;
}

.hero-image {
  height: 680rpx;
  object-fit: cover;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 40rpx 24rpx;
}

.work-card,
.package-card,
.booking-card {
  min-width: 0;
}

.grid .work-card {
  width: calc((100% - 24rpx) / 2);
}

.work-cover {
  height: 392rpx;
  object-fit: cover;
}

.package-cover {
  height: 420rpx;
  object-fit: cover;
}

.work-title,
.package-title {
  margin-top: 18rpx;
  color: #1a1a1a;
  font-family: "Songti SC", "STSong", "Times New Roman", serif;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.28;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.placeholder-card {
  width: calc((100% - 24rpx) / 2);
  min-height: 1rpx;
  background: transparent;
}

.more-button,
.primary-button,
.ghost-button {
  min-height: 88rpx;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 0.16em;
  box-sizing: border-box;
}

.primary-button {
  background: #1a1a1a;
  color: #fff;
}

.ghost-button,
.more-button {
  background: transparent;
  color: #1a1a1a;
  border: 1rpx solid rgba(26, 26, 26, 0.36);
}

.category-scroll {
  width: 100%;
  height: 92rpx;
  white-space: nowrap;
  margin: 28rpx 0 26rpx;
}

.category-row {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  height: 92rpx;
  min-width: max-content;
}

.category-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 128rpx;
  height: 68rpx;
  padding: 0 26rpx;
  border: 1rpx solid rgba(26, 26, 26, 0.18);
  border-radius: 0;
  background: transparent;
  color: #5d5f5f;
  font-size: 25rpx;
  white-space: nowrap;
}

.category-tab.active {
  border-color: #1a1a1a;
  background: #1a1a1a;
  color: #fff;
}

.category-label {
  margin: 2rpx 0 30rpx;
  color: #9b7a19;
  font-size: 21rpx;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.form-item {
  margin-bottom: 28rpx;
}

.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 92rpx;
  padding: 0;
  border: 0;
  border-bottom: 1rpx solid rgba(26, 26, 26, 0.22);
  border-radius: 0;
  background: transparent;
  color: #1a1a1a;
  font-size: 28rpx;
}

.textarea {
  min-height: 180rpx;
  padding-top: 22rpx;
  line-height: 1.65;
}

.picker-input {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  color: #5d5f5f;
}

.detail-nav {
  display: inline-flex;
  align-items: center;
  min-height: 64rpx;
  color: #1a1a1a;
  font-size: 25rpx;
  letter-spacing: 0.12em;
}

.detail-image {
  width: 100%;
  display: block;
  margin-bottom: 26rpx;
  background: #e9e7e1;
}

.success-panel {
  margin-top: 28vh;
  text-align: center;
}

.contact-section {
  background: #1a1a1a;
}

.contact-section .muted {
  color: rgba(255, 255, 255, 0.72);
}

.about-logo {
  width: 220rpx;
  height: 140rpx;
  margin: 40rpx 0;
  display: block;
}

.about-content {
  white-space: pre-wrap;
}

.qr-image {
  width: 220rpx;
  height: 220rpx;
  margin-top: 28rpx;
}

.large-cover {
  height: 520rpx;
  margin-bottom: 36rpx;
}

.package-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(26, 26, 26, 0.12);
}
