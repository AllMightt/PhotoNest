<view class="contact-dock">
  <image wx:if="{{contact.coverImage}}" class="dock-bg" src="{{contact.coverImage}}" mode="aspectFill" />
  <view class="dock-mask" />
  <view class="dock-content">
    <view class="dock-lines">
      <view class="dock-line">
        <text class="dock-label">微信：</text>
        <text class="dock-value">{{contact.wechatId || '暂未配置'}}</text>
        <text class="dock-action" bindtap="copyWechat">添加客服</text>
      </view>
      <view class="dock-line">
        <text class="dock-label">电话：</text>
        <text class="dock-value">{{contact.phone || '暂未配置'}}</text>
      </view>
      <view class="dock-line">
        <text class="dock-label">地址：</text>
        <text class="dock-value">{{contact.city || '暂未配置'}}</text>
      </view>
    </view>

    <view class="dock-icons">
      <view class="dock-icon" data-type="phone" bindtap="copyAccount">电话</view>
      <view class="dock-icon" data-type="wechat" bindtap="copyAccount">微信</view>
      <view class="dock-icon" data-type="xiaohongshu" bindtap="copyAccount">小红书</view>
      <view class="dock-icon" data-type="douyin" bindtap="copyAccount">抖音</view>
    </view>
  </view>
</view>
