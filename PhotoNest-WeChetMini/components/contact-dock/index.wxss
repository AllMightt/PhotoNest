.contact-dock {
  position: relative;
  min-height: 500rpx;
  margin-top: 72rpx;
  margin-left: -30rpx;
  margin-right: -30rpx;
  margin-bottom: calc(-156rpx - env(safe-area-inset-bottom));
  padding-bottom: calc(156rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background: #1a1a1a;
  color: #d8d8d8;
}

.dock-bg,
.dock-mask {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.dock-bg {
  opacity: 0.32;
}

.dock-mask {
  background: linear-gradient(180deg, rgba(12, 12, 12, 0.58), rgba(26, 26, 26, 0.96));
}

.dock-content {
  position: relative;
  z-index: 1;
  min-height: 500rpx;
  padding: 52rpx 36rpx 34rpx;
  box-sizing: border-box;
}

.dock-lines {
  padding-bottom: 36rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.16);
}

.dock-line {
  display: flex;
  align-items: baseline;
  min-height: 54rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: 28rpx;
  line-height: 1.5;
}

.dock-label {
  flex: none;
  color: rgba(255, 255, 255, 0.82);
}

.dock-value {
  max-width: 460rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dock-action {
  margin-left: 18rpx;
  color: #d4af37;
  font-size: 24rpx;
  text-decoration: underline;
}

.dock-icons {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 38rpx;
}

.dock-icon {
  width: 148rpx;
  height: 104rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.26);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.8);
  font-size: 22rpx;
  letter-spacing: 0.08em;
}
