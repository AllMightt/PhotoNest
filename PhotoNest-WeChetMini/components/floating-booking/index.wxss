.floating-area {
  position: fixed;
  inset: 0;
  z-index: 20;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
}

.floating-booking {
  width: 112rpx;
  height: 112rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.46);
  background: rgba(26, 26, 26, 0.94);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 0.08em;
  pointer-events: auto;
}
