<view class="page">
  <view class="section">
    <view class="eyebrow">ABOUT THE STUDIO</view>
    <view class="title">{{about.brandName || '关于我们'}}</view>
    <image wx:if="{{about.logoUrl}}" class="about-logo" src="{{about.logoUrl}}" mode="aspectFit" />
    <view class="muted about-content">{{about.aboutContent || about.intro || '用影像记录重要时刻。'}}</view>
  </view>

  <view class="section">
    <view class="eyebrow">CONTACT</view>
    <view class="work-title">联系方式</view>
    <view class="muted">微信：{{about.wechatId || '暂未配置'}}</view>
    <view class="muted" wx:if="{{about.xiaohongshuId}}">小红书：{{about.xiaohongshuId}}</view>
    <view class="muted" wx:if="{{about.douyinId}}">抖音：{{about.douyinId}}</view>
    <image wx:if="{{about.wechatQr}}" class="qr-image" src="{{about.wechatQr}}" mode="aspectFit" />
  </view>

  <contact-dock share-code="{{shareCode}}" />
  <floating-booking />
</view>
