<view class="page">
  <view class="detail-nav" bindtap="goBack">BACK</view>
  <view class="section">
    <image wx:if="{{pkg.coverUrl}}" class="package-cover large-cover" src="{{pkg.coverUrl}}" mode="aspectFill" />
    <view class="eyebrow">PACKAGE DETAIL</view>
    <view class="title">{{pkg.packageName}}</view>
    <view class="package-price">{{priceLabel}}</view>
    <view class="muted" wx:if="{{pkg.durationMinutes}}">拍摄时长：{{pkg.durationMinutes}} 分钟</view>
    <view class="muted" wx:if="{{pkg.originalPhotoCount}}">底片数量：{{pkg.originalPhotoCount}}</view>
    <view class="muted" wx:if="{{pkg.retouchPhotoCount}}">精修数量：{{pkg.retouchPhotoCount}}</view>
  </view>

  <view class="section" wx:if="{{items.length}}">
    <view class="eyebrow">INCLUDED</view>
    <view class="work-title">套系明细</view>
    <view wx:for="{{items}}" wx:key="id" class="package-item">
      <view>{{item.itemName}}</view>
      <view class="muted">{{item.itemValue || item.remark}}</view>
    </view>
  </view>

  <view class="primary-button detail-booking" bindtap="goBooking">预约这个套系</view>
  <floating-booking />
</view>
