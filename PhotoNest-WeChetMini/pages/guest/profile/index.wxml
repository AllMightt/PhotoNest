<view class="page">
  <view class="section">
    <view class="eyebrow">MY BOOKINGS</view>
    <view class="title">我的</view>
    <view class="muted">登录后查看预约记录和咨询状态。</view>
  </view>
  <view wx:for="{{bookings}}" wx:key="id" class="section booking-card">
    <view class="work-title">{{item.bookingNo || '预约咨询'}}</view>
    <view class="muted">手机号：{{item.maskedPhone}}</view>
    <view class="muted">状态：{{item.statusLabel}}</view>
  </view>
  <view wx:if="{{bookings.length === 0}}" class="section muted">暂无预约记录</view>
  <floating-booking />
</view>
