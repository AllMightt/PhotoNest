.work-detail-page {
  min-height: 100vh;
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
  background: #f9f9f9;
  color: #1a1a1a;
}

.cover-stage {
  position: relative;
  height: 920rpx;
  overflow: hidden;
  background: #1a1a1a;
}

.cover-image,
.cover-fallback {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.cover-fallback {
  background: #1a1a1a;
}

.cover-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.2) 42%, rgba(0, 0, 0, 0.78));
}

.cover-copy {
  position: absolute;
  left: 38rpx;
  right: 38rpx;
  bottom: 64rpx;
  z-index: 2;
  color: #fff;
}

.cover-eyebrow {
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
}

.cover-title {
  margin-top: 18rpx;
  font-family: "Songti SC", "STSong", "Times New Roman", serif;
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1.08;
}

.cover-meta {
  margin-top: 24rpx;
  min-height: 34rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 25rpx;
  line-height: 1.45;
}

.story-card {
  margin: 60rpx 30rpx 0;
  padding: 0 0 44rpx;
  border-bottom: 1rpx solid rgba(26, 26, 26, 0.14);
}

.story-label,
.gallery-eyebrow {
  color: #9b7a19;
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
}

.story-text {
  margin-top: 22rpx;
  color: #4f5050;
  font-size: 28rpx;
  line-height: 1.9;
}

.story-stats {
  display: flex;
  gap: 54rpx;
  margin-top: 40rpx;
}

.stat-num {
  color: #1a1a1a;
  font-family: "Songti SC", "STSong", "Times New Roman", serif;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.2;
}

.stat-label {
  margin-top: 8rpx;
  color: #777;
  font-size: 21rpx;
  letter-spacing: 0.08em;
}

.gallery-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 58rpx 30rpx 30rpx;
}

.gallery-title {
  margin-top: 12rpx;
  color: #1a1a1a;
  font-family: "Songti SC", "STSong", "Times New Roman", serif;
  font-size: 48rpx;
  font-weight: 600;
}

.gallery-count {
  color: #777;
  font-size: 22rpx;
  letter-spacing: 0.08em;
}

.image-flow {
  margin: 0 30rpx;
}

.detail-image {
  width: 100%;
  display: block;
  margin-bottom: 30rpx;
  background: #e9e7e1;
}

.empty-gallery {
  margin: 30rpx;
  padding: 86rpx 0;
  border-top: 1rpx solid rgba(26, 26, 26, 0.14);
  border-bottom: 1rpx solid rgba(26, 26, 26, 0.14);
  color: #777;
  font-size: 26rpx;
  text-align: center;
}

.bottom-consult {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(22rpx + env(safe-area-inset-bottom));
  z-index: 30;
  min-height: 112rpx;
  padding: 18rpx 18rpx 18rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(26, 26, 26, 0.94);
  box-sizing: border-box;
}

.consult-copy {
  min-width: 0;
  color: #fff;
}

.consult-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.25;
}

.consult-note {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 22rpx;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.consult-button {
  flex: none;
  width: 132rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: #1a1a1a;
  font-size: 26rpx;
  font-weight: 600;
}
