.page {
  padding-top: 52rpx;
}

.portfolio-head {
  padding-bottom: 18rpx;
}

.category-more {
  width: 220rpx;
  height: 64rpx;
  margin: 0 auto 30rpx;
  border: 1rpx solid rgba(26, 26, 26, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1a1a1a;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.18em;
}

.work-label {
  margin-top: 18rpx;
  color: #9b7a19;
  font-size: 19rpx;
  font-weight: 500;
  letter-spacing: 0.16em;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.work-subtitle {
  margin-top: 8rpx;
  color: #777;
  font-size: 23rpx;
  line-height: 1.45;
}

.works-more {
  width: 420rpx;
  height: 82rpx;
  margin: 56rpx auto 24rpx;
  border: 1rpx solid rgba(26, 26, 26, 0.36);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1a1a1a;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0.22em;
}
