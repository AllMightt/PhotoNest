<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.photo.mapper.PhotoBrandConfigMapper">

    <resultMap type="com.ruoyi.photo.domain.PhotoBrandConfig" id="PhotoBrandConfigResult">
        <id property="id" column="id" />
        <result property="photographerId" column="photographer_id" />
        <result property="brandName" column="brand_name" />
        <result property="photographerName" column="photographer_name" />
        <result property="logoUrl" column="logo_url" />
        <result property="coverImage" column="cover_image" />
        <result property="subtitle" column="subtitle" />
        <result property="intro" column="intro" />
        <result property="aboutContent" column="about_content" />
        <result property="city" column="city" />
        <result property="phone" column="phone" />
        <result property="wechatId" column="wechat_id" />
        <result property="wechatQr" column="wechat_qr" />
        <result property="xiaohongshuId" column="xiaohongshu_id" />
        <result property="xiaohongshuQr" column="xiaohongshu_qr" />
        <result property="douyinId" column="douyin_id" />
        <result property="douyinQr" column="douyin_qr" />
        <result property="shootProcess" column="shoot_process" />
        <result property="faqContent" column="faq_content" />
        <result property="status" column="status" />
        <result property="delFlag" column="del_flag" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectPhotoBrandConfigVo">
        select id, photographer_id, brand_name, photographer_name, logo_url, cover_image, subtitle, intro, about_content, city, phone, wechat_id, wechat_qr, xiaohongshu_id, xiaohongshu_qr, douyin_id, douyin_qr, shoot_process, faq_content, status, del_flag, create_by, create_time, update_by, update_time, remark from photo_brand_config
    </sql>

    <select id="selectPhotoBrandConfigList" parameterType="com.ruoyi.photo.domain.PhotoBrandConfig" resultMap="PhotoBrandConfigResult">
        <include refid="selectPhotoBrandConfigVo"/>
        <where>
            <if test="delFlag == null or delFlag == ''"> and del_flag = '0'</if>
            <if test="id != null"> and id = #{id}</if>
            <if test="photographerId != null"> and photographer_id = #{photographerId}</if>
            <if test="brandName != null and brandName != ''"> and brand_name = #{brandName}</if>
            <if test="photographerName != null and photographerName != ''"> and photographer_name = #{photographerName}</if>
            <if test="logoUrl != null and logoUrl != ''"> and logo_url = #{logoUrl}</if>
            <if test="coverImage != null and coverImage != ''"> and cover_image = #{coverImage}</if>
            <if test="subtitle != null and subtitle != ''"> and subtitle = #{subtitle}</if>
            <if test="intro != null and intro != ''"> and intro = #{intro}</if>
            <if test="aboutContent != null and aboutContent != ''"> and about_content = #{aboutContent}</if>
            <if test="city != null and city != ''"> and city = #{city}</if>
            <if test="phone != null and phone != ''"> and phone = #{phone}</if>
            <if test="wechatId != null and wechatId != ''"> and wechat_id = #{wechatId}</if>
            <if test="wechatQr != null and wechatQr != ''"> and wechat_qr = #{wechatQr}</if>
            <if test="xiaohongshuId != null and xiaohongshuId != ''"> and xiaohongshu_id = #{xiaohongshuId}</if>
            <if test="xiaohongshuQr != null and xiaohongshuQr != ''"> and xiaohongshu_qr = #{xiaohongshuQr}</if>
            <if test="douyinId != null and douyinId != ''"> and douyin_id = #{douyinId}</if>
            <if test="douyinQr != null and douyinQr != ''"> and douyin_qr = #{douyinQr}</if>
            <if test="shootProcess != null and shootProcess != ''"> and shoot_process = #{shootProcess}</if>
            <if test="faqContent != null and faqContent != ''"> and faq_content = #{faqContent}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
            <if test="delFlag != null and delFlag != ''"> and del_flag = #{delFlag}</if>
        </where>
    </select>

    <select id="selectPhotoBrandConfigById" parameterType="Long" resultMap="PhotoBrandConfigResult">
        <include refid="selectPhotoBrandConfigVo"/>
        where id = #{id} and del_flag = '0'
    </select>

    <select id="selectPhotoBrandConfigByPhotographerId" parameterType="Long" resultMap="PhotoBrandConfigResult">
        <include refid="selectPhotoBrandConfigVo"/>
        where photographer_id = #{photographerId} and del_flag = '0' limit 1
    </select>

    <select id="selectPhotoBrandConfigByIdAndPhotographerId" resultMap="PhotoBrandConfigResult">
        <include refid="selectPhotoBrandConfigVo"/>
        where id = #{id} and photographer_id = #{photographerId} and del_flag = '0'
    </select>

    <insert id="insertPhotoBrandConfig" parameterType="com.ruoyi.photo.domain.PhotoBrandConfig" useGeneratedKeys="true" keyProperty="id">
        insert into photo_brand_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="photographerId != null">photographer_id,</if>
            <if test="brandName != null">brand_name,</if>
            <if test="photographerName != null">photographer_name,</if>
            <if test="logoUrl != null">logo_url,</if>
            <if test="coverImage != null">cover_image,</if>
            <if test="subtitle != null">subtitle,</if>
            <if test="intro != null">intro,</if>
            <if test="aboutContent != null">about_content,</if>
            <if test="city != null">city,</if>
            <if test="phone != null">phone,</if>
            <if test="wechatId != null">wechat_id,</if>
            <if test="wechatQr != null">wechat_qr,</if>
            <if test="xiaohongshuId != null">xiaohongshu_id,</if>
            <if test="xiaohongshuQr != null">xiaohongshu_qr,</if>
            <if test="douyinId != null">douyin_id,</if>
            <if test="douyinQr != null">douyin_qr,</if>
            <if test="shootProcess != null">shoot_process,</if>
            <if test="faqContent != null">faq_content,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            create_time,
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="photographerId != null">#{photographerId},</if>
            <if test="brandName != null">#{brandName},</if>
            <if test="photographerName != null">#{photographerName},</if>
            <if test="logoUrl != null">#{logoUrl},</if>
            <if test="coverImage != null">#{coverImage},</if>
            <if test="subtitle != null">#{subtitle},</if>
            <if test="intro != null">#{intro},</if>
            <if test="aboutContent != null">#{aboutContent},</if>
            <if test="city != null">#{city},</if>
            <if test="phone != null">#{phone},</if>
            <if test="wechatId != null">#{wechatId},</if>
            <if test="wechatQr != null">#{wechatQr},</if>
            <if test="xiaohongshuId != null">#{xiaohongshuId},</if>
            <if test="xiaohongshuQr != null">#{xiaohongshuQr},</if>
            <if test="douyinId != null">#{douyinId},</if>
            <if test="douyinQr != null">#{douyinQr},</if>
            <if test="shootProcess != null">#{shootProcess},</if>
            <if test="faqContent != null">#{faqContent},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            sysdate(),
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updatePhotoBrandConfig" parameterType="com.ruoyi.photo.domain.PhotoBrandConfig">
        update photo_brand_config
        <set>
            <if test="photographerId != null">photographer_id = #{photographerId},</if>
            <if test="brandName != null">brand_name = #{brandName},</if>
            <if test="photographerName != null">photographer_name = #{photographerName},</if>
            <if test="logoUrl != null">logo_url = #{logoUrl},</if>
            <if test="coverImage != null">cover_image = #{coverImage},</if>
            <if test="subtitle != null">subtitle = #{subtitle},</if>
            <if test="intro != null">intro = #{intro},</if>
            <if test="aboutContent != null">about_content = #{aboutContent},</if>
            <if test="city != null">city = #{city},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="wechatId != null">wechat_id = #{wechatId},</if>
            <if test="wechatQr != null">wechat_qr = #{wechatQr},</if>
            <if test="xiaohongshuId != null">xiaohongshu_id = #{xiaohongshuId},</if>
            <if test="xiaohongshuQr != null">xiaohongshu_qr = #{xiaohongshuQr},</if>
            <if test="douyinId != null">douyin_id = #{douyinId},</if>
            <if test="douyinQr != null">douyin_qr = #{douyinQr},</if>
            <if test="shootProcess != null">shoot_process = #{shootProcess},</if>
            <if test="faqContent != null">faq_content = #{faqContent},</if>
            <if test="status != null">status = #{status},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <update id="deletePhotoBrandConfigById" parameterType="Long">
        update photo_brand_config set del_flag = '2', update_time = sysdate() where id = #{id}
    </update>

    <update id="deletePhotoBrandConfigByIds" parameterType="Long">
        update photo_brand_config set del_flag = '2', update_time = sysdate() where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <update id="deletePhotoBrandConfigByIdAndPhotographerId">
        update photo_brand_config set del_flag = '2', update_time = sysdate()
        where id = #{id} and photographer_id = #{photographerId}
    </update>

</mapper>
