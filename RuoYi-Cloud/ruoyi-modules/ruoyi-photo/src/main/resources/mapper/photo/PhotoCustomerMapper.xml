<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.photo.mapper.PhotoCustomerMapper">

    <resultMap type="com.ruoyi.photo.domain.PhotoCustomer" id="PhotoCustomerResult">
        <id property="id" column="id" />
        <result property="photographerId" column="photographer_id" />
        <result property="openid" column="openid" />
        <result property="nickname" column="nickname" />
        <result property="avatarUrl" column="avatar_url" />
        <result property="realName" column="real_name" />
        <result property="phone" column="phone" />
        <result property="wechatId" column="wechat_id" />
        <result property="status" column="status" />
        <result property="delFlag" column="del_flag" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectPhotoCustomerVo">
        select id, photographer_id, openid, nickname, avatar_url, real_name, phone, wechat_id, status, del_flag, create_by, create_time, update_by, update_time, remark from photo_customer
    </sql>

    <select id="selectPhotoCustomerList" parameterType="com.ruoyi.photo.domain.PhotoCustomer" resultMap="PhotoCustomerResult">
        <include refid="selectPhotoCustomerVo"/>
        <where>
            <if test="delFlag == null or delFlag == ''"> and del_flag = '0'</if>
            <if test="id != null"> and id = #{id}</if>
            <if test="photographerId != null"> and photographer_id = #{photographerId}</if>
            <if test="openid != null and openid != ''"> and openid = #{openid}</if>
            <if test="nickname != null and nickname != ''"> and nickname = #{nickname}</if>
            <if test="avatarUrl != null and avatarUrl != ''"> and avatar_url = #{avatarUrl}</if>
            <if test="realName != null and realName != ''"> and real_name = #{realName}</if>
            <if test="phone != null and phone != ''"> and phone = #{phone}</if>
            <if test="wechatId != null and wechatId != ''"> and wechat_id = #{wechatId}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
            <if test="delFlag != null and delFlag != ''"> and del_flag = #{delFlag}</if>
        </where>
    </select>

    <select id="selectPhotoCustomerById" parameterType="Long" resultMap="PhotoCustomerResult">
        <include refid="selectPhotoCustomerVo"/>
        where id = #{id} and del_flag = '0'
    </select>

    <select id="selectPhotoCustomerByIdAndPhotographerId" resultMap="PhotoCustomerResult">
        <include refid="selectPhotoCustomerVo"/>
        where id = #{id} and photographer_id = #{photographerId} and del_flag = '0'
    </select>

    <select id="selectPhotoCustomerByOpenidAndPhotographerId" resultMap="PhotoCustomerResult">
        <include refid="selectPhotoCustomerVo"/>
        where openid = #{openid} and photographer_id = #{photographerId} and del_flag = '0' limit 1
    </select>

    <insert id="insertPhotoCustomer" parameterType="com.ruoyi.photo.domain.PhotoCustomer" useGeneratedKeys="true" keyProperty="id">
        insert into photo_customer
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="photographerId != null">photographer_id,</if>
            <if test="openid != null">openid,</if>
            <if test="nickname != null">nickname,</if>
            <if test="avatarUrl != null">avatar_url,</if>
            <if test="realName != null">real_name,</if>
            <if test="phone != null">phone,</if>
            <if test="wechatId != null">wechat_id,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            create_time,
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="photographerId != null">#{photographerId},</if>
            <if test="openid != null">#{openid},</if>
            <if test="nickname != null">#{nickname},</if>
            <if test="avatarUrl != null">#{avatarUrl},</if>
            <if test="realName != null">#{realName},</if>
            <if test="phone != null">#{phone},</if>
            <if test="wechatId != null">#{wechatId},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            sysdate(),
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updatePhotoCustomer" parameterType="com.ruoyi.photo.domain.PhotoCustomer">
        update photo_customer
        <set>
            <if test="photographerId != null">photographer_id = #{photographerId},</if>
            <if test="openid != null">openid = #{openid},</if>
            <if test="nickname != null">nickname = #{nickname},</if>
            <if test="avatarUrl != null">avatar_url = #{avatarUrl},</if>
            <if test="realName != null">real_name = #{realName},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="wechatId != null">wechat_id = #{wechatId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <update id="deletePhotoCustomerById" parameterType="Long">
        update photo_customer set del_flag = '2', update_time = sysdate() where id = #{id}
    </update>

    <update id="deletePhotoCustomerByIds" parameterType="Long">
        update photo_customer set del_flag = '2', update_time = sysdate() where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <update id="deletePhotoCustomerByIdAndPhotographerId">
        update photo_customer set del_flag = '2', update_time = sysdate()
        where id = #{id} and photographer_id = #{photographerId}
    </update>

</mapper>
