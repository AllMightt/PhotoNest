        </trim>
    </insert>

    <update id="updatePhotoPhotographer" parameterType="com.ruoyi.photo.domain.PhotoPhotographer">
        update photo_photographer
        <set>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="brandName != null">brand_name = #{brandName},</if>
            <if test="photographerName != null">photographer_name = #{photographerName},</if>
            <if test="shareCode != null">share_code = #{shareCode},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="coverImage != null">cover_image = #{coverImage},</if>
