    <sql id="selectPhotoPhotographerVo">
        select id, user_id, brand_name, photographer_name, share_code, avatar, cover_image, city, phone, wechat_id, wechat_qr, xiaohongshu_id, xiaohongshu_qr, douyin_id, douyin_qr, status, plan_type, expire_time, storage_limit, storage_used, work_limit, package_limit, del_flag, create_by, create_time, update_by, update_time, remark from photo_photographer
    </sql>

    <select id="selectPhotoPhotographerList" parameterType="com.ruoyi.photo.domain.PhotoPhotographer" resultMap="PhotoPhotographerResult">
        <include refid="selectPhotoPhotographerVo"/>
        <where>
            <if test="delFlag == null or delFlag == ''"> and del_flag = '0'</if>
            <if test="id != null"> and id = #{id}</if>
            <if test="userId != null"> and user_id = #{userId}</if>
            <if test="brandName != null and brandName != ''"> and brand_name = #{brandName}</if>
            <if test="photographerName != null and photographerName != ''"> and photographer_name = #{photographerName}</if>
            <if test="shareCode != null and shareCode != ''"> and share_code = #{shareCode}</if>
            <if test="avatar != null and avatar != ''"> and avatar = #{avatar}</if>
            <if test="coverImage != null and coverImage != ''"> and cover_image = #{coverImage}</if>
            <if test="city != null and city != ''"> and city = #{city}</if>
            <if test="phone != null and phone != ''"> and phone = #{phone}</if>
            <if test="wechatId != null and wechatId != ''"> and wechat_id = #{wechatId}</if>
            <if test="wechatQr != null and wechatQr != ''"> and wechat_qr = #{wechatQr}</if>
            <if test="xiaohongshuId != null and xiaohongshuId != ''"> and xiaohongshu_id = #{xiaohongshuId}</if>
            <if test="xiaohongshuQr != null and xiaohongshuQr != ''"> and xiaohongshu_qr = #{xiaohongshuQr}</if>
            <if test="douyinId != null and douyinId != ''"> and douyin_id = #{douyinId}</if>
            <if test="douyinQr != null and douyinQr != ''"> and douyin_qr = #{douyinQr}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
            <if test="planType != null and planType != ''"> and plan_type = #{planType}</if>
            <if test="expireTime != null"> and expire_time = #{expireTime}</if>
            <if test="storageLimit != null"> and storage_limit = #{storageLimit}</if>
            <if test="storageUsed != null"> and storage_used = #{storageUsed}</if>
            <if test="workLimit != null"> and work_limit = #{workLimit}</if>
            <if test="packageLimit != null"> and package_limit = #{packageLimit}</if>
            <if test="delFlag != null and delFlag != ''"> and del_flag = #{delFlag}</if>
        </where>
    </select>

    <select id="selectPhotoPhotographerById" parameterType="Long" resultMap="PhotoPhotographerResult">
        <include refid="selectPhotoPhotographerVo"/>
        where id = #{id} and del_flag = '0'
    </select>

    <select id="selectPhotoPhotographerByUserId" parameterType="Long" resultMap="PhotoPhotographerResult">
        <include refid="selectPhotoPhotographerVo"/>
        where user_id = #{userId} and del_flag = '0' limit 1
    </select>

    <select id="selectPhotoPhotographerByShareCode" parameterType="String" resultMap="PhotoPhotographerResult">
        <include refid="selectPhotoPhotographerVo"/>
        where share_code = #{shareCode} and status = '0' and del_flag = '0' limit 1
    </select>

    <select id="selectPhotoPhotographerByIdAndPhotographerId" resultMap="PhotoPhotographerResult">
        <include refid="selectPhotoPhotographerVo"/>
        where id = #{id} and id = #{photographerId} and del_flag = '0'
    </select>

    <insert id="insertPhotoPhotographer" parameterType="com.ruoyi.photo.domain.PhotoPhotographer" useGeneratedKeys="true" keyProperty="id">
