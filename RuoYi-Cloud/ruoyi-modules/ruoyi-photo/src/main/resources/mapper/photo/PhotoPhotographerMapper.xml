            <if test="xiaohongshuId != null">xiaohongshu_id,</if>
            <if test="xiaohongshuQr != null">xiaohongshu_qr,</if>
            <if test="douyinId != null">douyin_id,</if>
            <if test="douyinQr != null">douyin_qr,</if>
            <if test="status != null">status,</if>
            <if test="planType != null">plan_type,</if>
            <if test="expireTime != null">expire_time,</if>
            <if test="storageLimit != null">storage_limit,</if>
            <if test="storageUsed != null">storage_used,</if>
            <if test="workLimit != null">work_limit,</if>
            <if test="packageLimit != null">package_limit,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            create_time,
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="userId != null">#{userId},</if>
            <if test="brandName != null">#{brandName},</if>
