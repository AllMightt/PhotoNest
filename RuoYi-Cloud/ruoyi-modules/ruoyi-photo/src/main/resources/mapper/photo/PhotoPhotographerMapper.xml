            <if test="workLimit != null">work_limit = #{workLimit},</if>
            <if test="packageLimit != null">package_limit = #{packageLimit},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <update id="deletePhotoPhotographerById" parameterType="Long">
        update photo_photographer set del_flag = '2', update_time = sysdate() where id = #{id}
    </update>

    <update id="deletePhotoPhotographerByIds" parameterType="Long">
        update photo_photographer set del_flag = '2', update_time = sysdate() where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <update id="deletePhotoPhotographerByIdAndPhotographerId">
        update photo_photographer set del_flag = '2', update_time = sysdate()
        where id = #{id} and id = #{photographerId}
    </update>

