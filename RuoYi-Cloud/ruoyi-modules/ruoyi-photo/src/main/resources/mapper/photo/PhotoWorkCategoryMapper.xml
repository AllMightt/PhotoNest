<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.photo.mapper.PhotoWorkCategoryMapper">

    <resultMap type="com.ruoyi.photo.domain.PhotoWorkCategory" id="PhotoWorkCategoryResult">
        <id property="id" column="id" />
        <result property="photographerId" column="photographer_id" />
        <result property="categoryName" column="category_name" />
        <result property="categoryIcon" column="category_icon" />
        <result property="sort" column="sort" />
        <result property="status" column="status" />
        <result property="delFlag" column="del_flag" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectPhotoWorkCategoryVo">
        select id, photographer_id, category_name, category_icon, sort, status, del_flag, create_by, create_time, update_by, update_time, remark from photo_work_category
    </sql>

    <select id="selectPhotoWorkCategoryList" parameterType="com.ruoyi.photo.domain.PhotoWorkCategory" resultMap="PhotoWorkCategoryResult">
        <include refid="selectPhotoWorkCategoryVo"/>
        <where>
            <if test="delFlag == null or delFlag == ''"> and del_flag = '0'</if>
            <if test="id != null"> and id = #{id}</if>
            <if test="photographerId != null"> and photographer_id = #{photographerId}</if>
            <if test="categoryName != null and categoryName != ''"> and category_name = #{categoryName}</if>
            <if test="categoryIcon != null and categoryIcon != ''"> and category_icon = #{categoryIcon}</if>
            <if test="sort != null"> and sort = #{sort}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
            <if test="delFlag != null and delFlag != ''"> and del_flag = #{delFlag}</if>
        </where>
        order by sort asc, id asc
    </select>

    <select id="selectPhotoWorkCategoryById" parameterType="Long" resultMap="PhotoWorkCategoryResult">
        <include refid="selectPhotoWorkCategoryVo"/>
        where id = #{id} and del_flag = '0'
    </select>

    <select id="selectPhotoWorkCategoryByIdAndPhotographerId" resultMap="PhotoWorkCategoryResult">
        <include refid="selectPhotoWorkCategoryVo"/>
        where id = #{id} and photographer_id = #{photographerId} and del_flag = '0'
    </select>

    <insert id="insertPhotoWorkCategory" parameterType="com.ruoyi.photo.domain.PhotoWorkCategory" useGeneratedKeys="true" keyProperty="id">
        insert into photo_work_category
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="photographerId != null">photographer_id,</if>
            <if test="categoryName != null">category_name,</if>
            <if test="categoryIcon != null">category_icon,</if>
            <if test="sort != null">sort,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            create_time,
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="photographerId != null">#{photographerId},</if>
            <if test="categoryName != null">#{categoryName},</if>
            <if test="categoryIcon != null">#{categoryIcon},</if>
            <if test="sort != null">#{sort},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            sysdate(),
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updatePhotoWorkCategory" parameterType="com.ruoyi.photo.domain.PhotoWorkCategory">
        update photo_work_category
        <set>
            <if test="photographerId != null">photographer_id = #{photographerId},</if>
            <if test="categoryName != null">category_name = #{categoryName},</if>
            <if test="categoryIcon != null">category_icon = #{categoryIcon},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <update id="deletePhotoWorkCategoryById" parameterType="Long">
        update photo_work_category set del_flag = '2', update_time = sysdate() where id = #{id}
    </update>

    <update id="deletePhotoWorkCategoryByIds" parameterType="Long">
        update photo_work_category set del_flag = '2', update_time = sysdate() where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <update id="deletePhotoWorkCategoryByIdAndPhotographerId">
        update photo_work_category set del_flag = '2', update_time = sysdate()
        where id = #{id} and photographer_id = #{photographerId}
    </update>

</mapper>
