<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.photo.mapper.PhotoWorkImageMapper">

    <resultMap type="com.ruoyi.photo.domain.PhotoWorkImage" id="PhotoWorkImageResult">
        <id property="id" column="id" />
        <result property="photographerId" column="photographer_id" />
        <result property="workId" column="work_id" />
        <result property="originalUrl" column="original_url" />
        <result property="displayUrl" column="display_url" />
        <result property="thumbnailUrl" column="thumbnail_url" />
        <result property="watermarkUrl" column="watermark_url" />
        <result property="fileName" column="file_name" />
        <result property="fileSize" column="file_size" />
        <result property="width" column="width" />
        <result property="height" column="height" />
        <result property="sort" column="sort" />
        <result property="status" column="status" />
        <result property="delFlag" column="del_flag" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectPhotoWorkImageVo">
        select id, photographer_id, work_id, original_url, display_url, thumbnail_url, watermark_url, file_name, file_size, width, height, sort, status, del_flag, create_by, create_time, update_by, update_time, remark from photo_work_image
    </sql>

    <select id="selectPhotoWorkImageList" parameterType="com.ruoyi.photo.domain.PhotoWorkImage" resultMap="PhotoWorkImageResult">
        <include refid="selectPhotoWorkImageVo"/>
        <where>
            <if test="delFlag == null or delFlag == ''"> and del_flag = '0'</if>
            <if test="id != null"> and id = #{id}</if>
            <if test="photographerId != null"> and photographer_id = #{photographerId}</if>
            <if test="workId != null"> and work_id = #{workId}</if>
            <if test="originalUrl != null and originalUrl != ''"> and original_url = #{originalUrl}</if>
            <if test="displayUrl != null and displayUrl != ''"> and display_url = #{displayUrl}</if>
            <if test="thumbnailUrl != null and thumbnailUrl != ''"> and thumbnail_url = #{thumbnailUrl}</if>
            <if test="watermarkUrl != null and watermarkUrl != ''"> and watermark_url = #{watermarkUrl}</if>
            <if test="fileName != null and fileName != ''"> and file_name = #{fileName}</if>
            <if test="fileSize != null"> and file_size = #{fileSize}</if>
            <if test="width != null"> and width = #{width}</if>
            <if test="height != null"> and height = #{height}</if>
            <if test="sort != null"> and sort = #{sort}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
            <if test="delFlag != null and delFlag != ''"> and del_flag = #{delFlag}</if>
        </where>
    </select>

    <select id="selectPhotoWorkImageById" parameterType="Long" resultMap="PhotoWorkImageResult">
        <include refid="selectPhotoWorkImageVo"/>
        where id = #{id} and del_flag = '0'
    </select>

    <select id="selectPhotoWorkImageByIdAndPhotographerId" resultMap="PhotoWorkImageResult">
        <include refid="selectPhotoWorkImageVo"/>
        where id = #{id} and photographer_id = #{photographerId} and del_flag = '0'
    </select>

    <insert id="insertPhotoWorkImage" parameterType="com.ruoyi.photo.domain.PhotoWorkImage" useGeneratedKeys="true" keyProperty="id">
        insert into photo_work_image
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="photographerId != null">photographer_id,</if>
            <if test="workId != null">work_id,</if>
            <if test="originalUrl != null">original_url,</if>
            <if test="displayUrl != null">display_url,</if>
            <if test="thumbnailUrl != null">thumbnail_url,</if>
            <if test="watermarkUrl != null">watermark_url,</if>
            <if test="fileName != null">file_name,</if>
            <if test="fileSize != null">file_size,</if>
            <if test="width != null">width,</if>
            <if test="height != null">height,</if>
            <if test="sort != null">sort,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            create_time,
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="photographerId != null">#{photographerId},</if>
            <if test="workId != null">#{workId},</if>
            <if test="originalUrl != null">#{originalUrl},</if>
            <if test="displayUrl != null">#{displayUrl},</if>
            <if test="thumbnailUrl != null">#{thumbnailUrl},</if>
            <if test="watermarkUrl != null">#{watermarkUrl},</if>
            <if test="fileName != null">#{fileName},</if>
            <if test="fileSize != null">#{fileSize},</if>
            <if test="width != null">#{width},</if>
            <if test="height != null">#{height},</if>
            <if test="sort != null">#{sort},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            sysdate(),
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updatePhotoWorkImage" parameterType="com.ruoyi.photo.domain.PhotoWorkImage">
        update photo_work_image
        <set>
            <if test="photographerId != null">photographer_id = #{photographerId},</if>
            <if test="workId != null">work_id = #{workId},</if>
            <if test="originalUrl != null">original_url = #{originalUrl},</if>
            <if test="displayUrl != null">display_url = #{displayUrl},</if>
            <if test="thumbnailUrl != null">thumbnail_url = #{thumbnailUrl},</if>
            <if test="watermarkUrl != null">watermark_url = #{watermarkUrl},</if>
            <if test="fileName != null">file_name = #{fileName},</if>
            <if test="fileSize != null">file_size = #{fileSize},</if>
            <if test="width != null">width = #{width},</if>
            <if test="height != null">height = #{height},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <update id="deletePhotoWorkImageById" parameterType="Long">
        update photo_work_image set del_flag = '2', update_time = sysdate() where id = #{id}
    </update>

    <update id="deletePhotoWorkImageByIds" parameterType="Long">
        update photo_work_image set del_flag = '2', update_time = sysdate() where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <update id="deletePhotoWorkImageByIdAndPhotographerId">
        update photo_work_image set del_flag = '2', update_time = sysdate()
        where id = #{id} and photographer_id = #{photographerId}
    </update>

</mapper>
