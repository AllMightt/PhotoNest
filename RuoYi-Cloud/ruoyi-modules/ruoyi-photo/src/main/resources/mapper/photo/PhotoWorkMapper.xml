<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.photo.mapper.PhotoWorkMapper">

    <resultMap type="com.ruoyi.photo.domain.PhotoWork" id="PhotoWorkResult">
        <id property="id" column="id" />
        <result property="photographerId" column="photographer_id" />
        <result property="categoryId" column="category_id" />
        <result property="title" column="title" />
        <result property="coverUrl" column="cover_url" />
        <result property="tags" column="tags" />
        <result property="shootType" column="shoot_type" />
        <result property="shootLocation" column="shoot_location" />
        <result property="shootTime" column="shoot_time" />
        <result property="description" column="description" />
        <result property="isHomeRecommend" column="is_home_recommend" />
        <result property="publishTime" column="publish_time" />
        <result property="sort" column="sort" />
        <result property="viewCount" column="view_count" />
        <result property="status" column="status" />
        <result property="delFlag" column="del_flag" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectPhotoWorkVo">
        select id, photographer_id, category_id, title, cover_url, tags, shoot_type, shoot_location, shoot_time, description, is_home_recommend, publish_time, sort, view_count, status, del_flag, create_by, create_time, update_by, update_time, remark from photo_work
    </sql>

    <select id="selectPhotoWorkList" parameterType="com.ruoyi.photo.domain.PhotoWork" resultMap="PhotoWorkResult">
        <include refid="selectPhotoWorkVo"/>
        <where>
            <if test="delFlag == null or delFlag == ''"> and del_flag = '0'</if>
            <if test="id != null"> and id = #{id}</if>
            <if test="photographerId != null"> and photographer_id = #{photographerId}</if>
            <if test="categoryId != null"> and category_id = #{categoryId}</if>
            <if test="title != null and title != ''"> and title = #{title}</if>
            <if test="coverUrl != null and coverUrl != ''"> and cover_url = #{coverUrl}</if>
            <if test="tags != null and tags != ''"> and tags = #{tags}</if>
            <if test="shootType != null and shootType != ''"> and shoot_type = #{shootType}</if>
            <if test="shootLocation != null and shootLocation != ''"> and shoot_location = #{shootLocation}</if>
            <if test="shootTime != null"> and shoot_time = #{shootTime}</if>
            <if test="description != null and description != ''"> and description = #{description}</if>
            <if test="isHomeRecommend != null and isHomeRecommend != ''"> and is_home_recommend = #{isHomeRecommend}</if>
            <if test="publishTime != null"> and publish_time = #{publishTime}</if>
            <if test="sort != null"> and sort = #{sort}</if>
            <if test="viewCount != null"> and view_count = #{viewCount}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
            <if test="delFlag != null and delFlag != ''"> and del_flag = #{delFlag}</if>
        </where>
    </select>

    <select id="selectPhotoWorkById" parameterType="Long" resultMap="PhotoWorkResult">
        <include refid="selectPhotoWorkVo"/>
        where id = #{id} and del_flag = '0'
    </select>

    <select id="selectHomeRecommendList" resultMap="PhotoWorkResult">
        <include refid="selectPhotoWorkVo"/>
        where photographer_id = #{photographerId}
          and is_home_recommend = '1'
          and status = '0'
          and del_flag = '0'
        order by sort asc, publish_time desc, id desc
        limit #{limit}
    </select>

    <select id="selectHomeLatestList" resultMap="PhotoWorkResult">
        <include refid="selectPhotoWorkVo"/>
        where photographer_id = #{photographerId}
          and status = '0'
          and del_flag = '0'
        order by publish_time desc, id desc
        limit #{limit}
    </select>

    <select id="selectAppPhotoWorkList" parameterType="com.ruoyi.photo.domain.PhotoWork" resultMap="PhotoWorkResult">
        <include refid="selectPhotoWorkVo"/>
        <where>
            and photographer_id = #{photographerId}
            and status = '0'
            and del_flag = '0'
            <if test="categoryId != null"> and category_id = #{categoryId}</if>
        </where>
        order by publish_time desc, id desc
    </select>

    <select id="selectPhotoWorkByIdAndPhotographerId" resultMap="PhotoWorkResult">
        <include refid="selectPhotoWorkVo"/>
        where id = #{id} and photographer_id = #{photographerId} and del_flag = '0'
    </select>

    <insert id="insertPhotoWork" parameterType="com.ruoyi.photo.domain.PhotoWork" useGeneratedKeys="true" keyProperty="id">
        insert into photo_work
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="photographerId != null">photographer_id,</if>
            <if test="categoryId != null">category_id,</if>
            <if test="title != null">title,</if>
            <if test="coverUrl != null">cover_url,</if>
            <if test="tags != null">tags,</if>
            <if test="shootType != null">shoot_type,</if>
            <if test="shootLocation != null">shoot_location,</if>
            <if test="shootTime != null">shoot_time,</if>
            <if test="description != null">description,</if>
            <if test="isHomeRecommend != null">is_home_recommend,</if>
            <if test="publishTime != null">publish_time,</if>
            <if test="sort != null">sort,</if>
            <if test="viewCount != null">view_count,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            create_time,
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="photographerId != null">#{photographerId},</if>
            <if test="categoryId != null">#{categoryId},</if>
            <if test="title != null">#{title},</if>
            <if test="coverUrl != null">#{coverUrl},</if>
            <if test="tags != null">#{tags},</if>
            <if test="shootType != null">#{shootType},</if>
            <if test="shootLocation != null">#{shootLocation},</if>
            <if test="shootTime != null">#{shootTime},</if>
            <if test="description != null">#{description},</if>
            <if test="isHomeRecommend != null">#{isHomeRecommend},</if>
            <if test="publishTime != null">#{publishTime},</if>
            <if test="sort != null">#{sort},</if>
            <if test="viewCount != null">#{viewCount},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            sysdate(),
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updatePhotoWork" parameterType="com.ruoyi.photo.domain.PhotoWork">
        update photo_work
        <set>
            <if test="photographerId != null">photographer_id = #{photographerId},</if>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="title != null">title = #{title},</if>
            <if test="coverUrl != null">cover_url = #{coverUrl},</if>
            <if test="tags != null">tags = #{tags},</if>
            <if test="shootType != null">shoot_type = #{shootType},</if>
            <if test="shootLocation != null">shoot_location = #{shootLocation},</if>
            <if test="shootTime != null">shoot_time = #{shootTime},</if>
            <if test="description != null">description = #{description},</if>
            <if test="isHomeRecommend != null">is_home_recommend = #{isHomeRecommend},</if>
            <if test="publishTime != null">publish_time = #{publishTime},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="viewCount != null">view_count = #{viewCount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <update id="deletePhotoWorkById" parameterType="Long">
        update photo_work set del_flag = '2', update_time = sysdate() where id = #{id}
    </update>

    <update id="deletePhotoWorkByIds" parameterType="Long">
        update photo_work set del_flag = '2', update_time = sysdate() where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <update id="deletePhotoWorkByIdAndPhotographerId">
        update photo_work set del_flag = '2', update_time = sysdate()
        where id = #{id} and photographer_id = #{photographerId}
    </update>

</mapper>
